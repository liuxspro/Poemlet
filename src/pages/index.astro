---
export const prerender = true;

import Poem from "../components/Poem.astro";
import PoemDisplay from "../components/PoemDisplay.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <Poem>
        <PoemDisplay />
    </Poem>
</Layout>

<script>
    const apiUrl = "https://service.liuxs.pro/poetry/api/poems/random";

    interface PoemData {
        id: number;
        title: string;
        content: string[];
        author: { name: string };
        dynasty: { name: string };
        type: { name: string };
    }

    interface PoemResponse {
        data: PoemData;
    }

    async function fetchPoem() {
        const contentEl = document.getElementById("poem-content")!;
        contentEl.innerHTML = `<p class="poem-loading">正在加载诗词...</p>`;

        try {
            const res = await fetch(apiUrl);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const json: PoemResponse = await res.json();
            const poem = json.data;

            const linesHtml = poem.content
                .map((line) => `<p class="poem-line">${line}</p>`)
                .join("");

            document.getElementById("type-name")!.textContent = poem.type.name;

            contentEl.innerHTML = `
                <h1 class="poem-title">${poem.title}</h1>
                <p class="poem-byline">
                    <span class="dynasty-badge">${poem.dynasty.name}</span>
                    <span class="poem-author">${poem.author.name}</span>
                </p>
                ${linesHtml}
            `;
        } catch (e) {
            contentEl.innerHTML = `<p class="poem-error">加载失败，请稍后重试</p>`;
            console.error("Failed to fetch poem:", e);
        }
    }

    fetchPoem();
</script>
